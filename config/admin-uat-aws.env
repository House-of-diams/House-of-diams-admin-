# NONSECRET UAT settings. Apply to the hosted environment; this file is not
# auto-loaded by Next.js. NEXT_PUBLIC_* must also be present during the build.
# See docs/aws-phase-d/ADMIN-UAT-CONFIGURATION.md for private runtime inputs.
# HOD-010: pinned issuer/bucket set (uat or production). Needed at build and runtime.
NEXT_PUBLIC_HOD_DEPLOYMENT=uat
ADMIN_AUTH_PROVIDER=keycloak
ADMIN_PRODUCT_DATA_PROVIDER=rds
ADMIN_CATALOG_DATA_PROVIDER=rds
ADMIN_CMS_DATA_PROVIDER=rds
ADMIN_OPERATIONS_DATA_PROVIDER=rds
ADMIN_IMAGE_PROVIDER=aws
ADMIN_VIDEO_PROVIDER=aws
ADMIN_OIDC_ISSUER=https://auth-uat.houseofdiams.com/realms/houseofdiams
ADMIN_OIDC_CLIENT_ID=hod-admin
ADMIN_OIDC_TOKEN_AUTH_METHOD=client_secret_basic
ADMIN_OIDC_ROLE_LOCATION=realm
ADMIN_OIDC_REQUIRED_ROLE=hod-admin
ADMIN_AUTH_ORIGIN=https://manage-uat.houseofdiams.com
ADMIN_AUTH_POLICY_VERIFIED=true
ADMIN_SESSION_STORAGE_VERIFIED=true
ADMIN_SESSION_NAMESPACE=hod-admin:uat-hosted
ADMIN_SESSION_MAX_SECONDS=36000
ADMIN_SESSION_IDLE_SECONDS=1800
ADMIN_SESSION_REVALIDATE_SECONDS=300
ADMIN_DB_LOGIN_ROLE=hod_admin_login_uat
AWS_REGION=us-east-1
AWS_MEDIA_BUCKET=house-of-diams
NEXT_PUBLIC_MEDIA_CDN_BASE_URL=https://media.houseofdiams.com
AWS_CONTENT_BUCKET=house-of-diams-hod
AWS_CONTENT_CDN_BASE_URL=https://content.houseofdiams.com
ADMIN_IMAGE_CONTENT_ROUTING_VERIFIED=true
ADMIN_VIDEO_ROUTING_VERIFIED=true
ADMIN_VIDEO_ADMISSION_PROVIDER=rds
ADMIN_VIDEO_ADMISSION_POLICY=hod-uat-video-v1
# Video publication is ON. The S3 bucket policies (conditional create, no delete) were verified on 2026-10-22.
# Do not deploy this value until admin_media.policy.enabled is true in the database (see VIDEO-SWITCH-ON.md);
# until then every upload is refused with a clear message and nothing is stored.
ADMIN_VIDEO_IMMUTABILITY_VERIFIED=true
